-- TYPOGRAPHY
-- Builder Sans: clean, modern and well suited for compact Roblox UI.
------------------------------------------------------------
local function uiFont(weight)
    return Font.new(
        "rbxasset://fonts/families/BuilderSans.json",
        weight or Enum.FontWeight.Regular,
        Enum.FontStyle.Normal
    )
end

